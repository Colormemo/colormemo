# Скопируйте в .env (он в .gitignore).

# Подключение к базе. Порт 5433 — как в compose.yaml.
DATABASE_URL="postgresql://app:dev@localhost:5433/colormemo?schema=public"

# Порт API. Фронт и API живут на одном домене, поэтому в готовом виде
# этот же порт отдаёт и сайт.
PORT=3000

# Секрет для подписи токенов сессии. Подделать токен, не зная секрет,
# нельзя — поэтому в настоящем развёртывании он обязан быть свой,
# и сервер с NODE_ENV=production не запустится со значением из примера.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="dev-secret-change-me"

# Работать без базы: пользователи, задания и результаты лежат в файле.
# Нужно, когда Postgres не поднят: npm run dev:nodb
USE_MEMORY_DB=false

# Куда писать данные в режиме без базы. Папка .data в .gitignore.
DATA_FILE=".data/colormemo.json"

# Папка с собранным фронтом. Пусто — сервер работает как чистое API
# (так и нужно в разработке, где фронт поднимает Vite).
CLIENT_DIR=
